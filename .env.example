# Copia este archivo como .env para probar "npm run actualizar" en tu computador.
# .env está en .gitignore: NUNCA lo subas. En GitHub la clave va en Secrets.
ANTHROPIC_API_KEY=

# Opcionales: si los dejas vacíos se usan los valores por defecto (entre paréntesis).
# CLAUDE_MODELO=              # claude-opus-5-5 (o claude-sonnet-5-5, más barato)
# CLAUDE_ESFUERZO=            # medium (low, medium, high)
# BUSQUEDA_WEB=               # si
# MAX_PRODUCTOS_NUEVOS=       # 6 propuestas por ejecución (tope 20)
# MAX_POR_CATEGORIA=          # 2
# MAX_PENDIENTES=             # 12: si ya hay tantos sin revisar, no se piden más
# MAX_RETIROS=                # 2 (0 = nunca quitar productos)
# MAX_BUSQUEDAS_POR_CATEGORIA= # 3
# MAX_TOKENS_RESPUESTA=       # 16000
# MAX_TOKENS_EJECUCION=       # 400000
