---
import '../styles/global.css';
import Header from '../components/Header.astro';
import AvisoAfiliado from '../components/AvisoAfiliado.astro';
import Footer from '../components/Footer.astro';
import { SITIO } from '../config';

interface Props {
  /** Título de la página, sin el nombre del sitio. En la portada se omite. */
  titulo?: string;
  /** Meta description: idealmente entre 70 y 160 caracteres. */
  descripcion?: string;
  /** Imagen para compartir en redes (URL absoluta). */
  imagen?: string;
  /** true para páginas que no deben aparecer en buscadores (ej. 404). */
  noIndex?: boolean;
}

const { titulo, descripcion = SITIO.descripcion, imagen, noIndex = false } = Astro.props;

const tituloCompleto = titulo ? `${titulo} | ${SITIO.nombre}` : `${SITIO.nombre}: ${SITIO.lema}`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
// Google muestra unos 160 caracteres: si es más larga, se corta en el último espacio.
const metaDescripcion =
  descripcion.length > 160 ? `${descripcion.slice(0, 157).replace(/\s+\S*$/, '').replace(/[,;:]$/, '')}…` : descripcion;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={metaDescripcion} />
    <link rel="canonical" href={canonica} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={metaDescripcion} />
    <meta property="og:url" content={canonica} />
    {imagen && <meta property="og:image" content={imagen} />}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://m.media-amazon.com" />
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header />
    <AvisoAfiliado />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
