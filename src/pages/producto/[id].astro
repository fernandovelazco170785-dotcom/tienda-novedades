---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import BotonAmazon from '../../components/BotonAmazon.astro';
import PrecioAmazon from '../../components/PrecioAmazon.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { AVISO_AFILIADO } from '../../config';
import {
  categoriaDe,
  formatearFecha,
  imagenConTamano,
  imagenDe,
  relacionados,
  srcsetImagen,
  todosLosProductos,
  urlCategoria,
  type Producto,
} from '../../lib/catalogo';

export function getStaticPaths() {
  return todosLosProductos().map((producto) => ({
    params: { id: producto.id },
    props: { producto },
  }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const categoria = categoriaDe(producto);
const otros = relacionados(producto, 3);
const imagen = imagenDe(producto);
const imagenGrande = imagen ? imagenConTamano(imagen, 800) : '';
---

<Base titulo={producto.titulo} descripcion={producto.descripcion_corta} imagen={imagenGrande || undefined}>
  <Migas
    pasos={[
      { texto: 'Inicio', href: '/' },
      { texto: categoria.nombre, href: urlCategoria(categoria.slug) },
      { texto: producto.titulo },
    ]}
  />

  <article class="seccion">
    <div class="contenedor ficha">
      <div class="ficha__imagen">
        {
          imagen ? (
            <img
              src={imagenGrande}
              srcset={srcsetImagen(imagen, [400, 600, 800])}
              sizes="(min-width: 52rem) 28rem, 92vw"
              alt={producto.titulo}
              width="800"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <span class="ficha__sin-imagen">Imagen no disponible</span>
          )
        }
      </div>

      <div class="ficha__info">
        <a href={urlCategoria(categoria.slug)} class="ficha__categoria">{categoria.nombre}</a>
        <h1 class="ficha__titulo">{producto.titulo}</h1>
        <p class="ficha__descripcion">{producto.descripcion_corta}</p>

        <div class="ficha__compra">
          <PrecioAmazon producto={producto} />
          <BotonAmazon producto={producto} texto="Ver en Amazon" grande />
          <p class="ficha__nota">
            {AVISO_AFILIADO} El precio y la disponibilidad pueden cambiar: revisa el precio final en Amazon antes de comprar.
          </p>
        </div>

        <p class="ficha__fecha">
          Agregado el <time datetime={producto.fecha_agregado}>{formatearFecha(producto.fecha_agregado)}</time>
        </p>
      </div>
    </div>
  </article>

  {
    otros.length > 0 && (
      <section class="seccion" aria-labelledby="titulo-relacionados">
        <div class="contenedor">
          <div class="seccion__cabecera">
            <h2 id="titulo-relacionados">Más en {categoria.nombre}</h2>
          </div>
          <div class="grilla-productos">
            {otros.map((p) => (
              <TarjetaProducto producto={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .ficha {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 52rem) {
    .ficha {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .ficha__imagen {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .ficha__imagen img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ficha__sin-imagen {
    color: var(--texto-tenue);
  }

  .ficha__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ficha__categoria {
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .ficha__titulo {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.2rem);
  }

  .ficha__descripcion {
    color: var(--texto-suave);
    font-size: 1.05rem;
  }

  .ficha__compra {
    display: grid;
    gap: 0.9rem;
    padding: 1.25rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .ficha__nota {
    color: var(--texto-tenue);
    font-size: 0.8rem;
  }

  .ficha__fecha {
    color: var(--texto-tenue);
    font-size: 0.85rem;
  }
</style>
